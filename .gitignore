# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# real question bank content stays private, never pushed to the public repo
/data/*.csv
/data/*.sql
/data/archive-checkpoint.txt
!/data/questions.template.csv

# source PDFs/exports the user drops in for transcription -- same privacy
# reasoning as the CSV/SQL above, never pushed to the public repo
*.pdf

# local-only /dev-preview fixture harness for exercising the app without a
# real Google OAuth session (see src/dev/AI_INSTRUCTIONS.md for what it is
# and how to recreate it -- that one file is the tracked exception)
/src/app/dev-preview/
/src/dev/*
!/src/dev/AI_INSTRUCTIONS.md

# typescript
*.tsbuildinfo
next-env.d.ts
